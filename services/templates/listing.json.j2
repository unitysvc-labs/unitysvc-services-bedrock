{
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc PR #1196 / issue #1138). #}
  "name": "{{ provider_name }}/{{ offering_name }}",
{%- if list_price %}
  "list_price": {{ list_price | tojson }},
{%- endif %}
  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ provider_name }}",
      "routing_key": {"model": "{{ offering_name }}"}
    }
  },
  "documents": {
    "How to use this model": {
      "$doc_preset": "llm_description"
    },
    "Python code example": {
      "$doc_preset": "llm_code_example_openai", "meta": {"sleep_after_test": 5}
    },
    "Python code example (Anthropic-style input)": {
      "$doc_preset": "llm_code_example_anthropic_to_openai_sdk", "meta": {"sleep_after_test": 5}
    },
    "cURL code example (Anthropic-style input)": {
      "$doc_preset": "llm_code_example_anthropic_to_openai_shell", "meta": {"sleep_after_test": 5}
    },
    "Python function calling code example": {
      "$doc_preset": "llm_code_example_fc_requests", "meta": {"sleep_after_test": 5}
    },
    "JavaScript code example": {
      "$doc_preset": "llm_code_example_javascript", "meta": {"sleep_after_test": 5}
    },
    "cURL code example": {
      "$doc_preset": "llm_code_example_shell", "meta": {"sleep_after_test": 5}
    },
    "Connectivity test": {
      "$doc_preset": "llm_connectivity", "meta": {"sleep_after_test": 5}
    },
    "Default request body": {
      "$doc_preset": "llm_request_template"
    }
  }
}

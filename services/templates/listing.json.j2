{
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc PR #1196 / issue #1138). #}
  "name": "{{ provider_name }}/{{ offering_name }}",
{%- if list_price %}
  "list_price": {{ list_price | tojson }},
{%- endif %}
  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ provider_name }}",
      "routing_key": {"model": "{{ offering_name }}"}
    }
  },
{#- Preset overrides (meta etc.) must be NESTED inside the sentinel value —
    a sibling key next to "$doc_preset" is rejected by expand_presets(). #}
  "documents": {
    "How to use this model": {
      "$doc_preset": "llm_description"
    },
    "Python code example": {
      "$doc_preset": {"name": "llm_code_example_openai", "meta": {"sleep_after_test": 5}}
    },
    "Python code example (Anthropic-style input)": {
      "$doc_preset": {"name": "llm_code_example_anthropic_to_openai_requests", "meta": {"sleep_after_test": 5}}
    },
    "cURL code example (Anthropic-style input)": {
      "$doc_preset": {"name": "llm_code_example_anthropic_to_openai_shell", "meta": {"sleep_after_test": 5}}
    },
{#- Only models that accept the OpenAI ``tools`` param get the function-calling
    example; others 400/500 on it (probed by update_params.py -> supports_tools). #}
{%- if supports_tools | default(false) %}
    "Python function calling code example": {
      "$doc_preset": {"name": "llm_code_example_fc_requests", "meta": {"sleep_after_test": 5}}
    },
{%- endif %}
    "JavaScript code example": {
      "$doc_preset": {"name": "llm_code_example_javascript", "meta": {"sleep_after_test": 5}}
    },
    "cURL code example": {
      "$doc_preset": {"name": "llm_code_example_shell", "meta": {"sleep_after_test": 5}}
    },
{#- Native Bedrock runtime (boto3) examples for the converse channel
    (unitysvc/unitysvc#1786). Local files for now; promote to unitysvc-data
    presets (bedrock_code_example_converse / _invoke) once stabilized. #}
    "Python code example (boto3 Converse)": {
      "category": "code_example",
      "description": "Call this model with the native AWS SDK: boto3 converse() pointed at the UnitySVC gateway.",
      "file_path": "../../../docs/converse-code-example.py.j2",
      "is_active": true,
      "is_public": true,
      "meta": {"channels": ["converse"], "output_contains": "connectivity ok", "requirements": ["boto3"], "sleep_after_test": 5},
      "mime_type": "python"
    },
    "Python code example (boto3 InvokeModel)": {
      "category": "code_example",
      "description": "Call this model with boto3 invoke_model() pointed at the UnitySVC gateway. The request body is the provider's native format.",
      "file_path": "../../../docs/invoke-code-example.py.j2",
      "is_active": true,
      "is_public": true,
      "meta": {"channels": ["converse"], "requirements": ["boto3"], "test": {"status": "skip"}},
      "mime_type": "python"
    },
    "Connectivity test": {
      "$doc_preset": {"name": "llm_connectivity", "meta": {"sleep_after_test": 5}}
    },
    "Default request body": {
      "$doc_preset": "llm_request_template"
    }
  }
}

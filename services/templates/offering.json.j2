{
  "name": "{{ offering_name }}",
  "display_name": "{{ display_name }}",
{#- Marketplace copy (unitysvc/unitysvc#1838): the teaser paragraph now lives
    in the required `summary` field (max 200 chars, shown in the collapsed
    list view), so it carries the dual-dialect differentiator; the length
    guard keeps it under the validator's cap. `description` holds the
    long-form detail + how-to + interop + pricing paragraphs. #}
{%- set _base = description | default(display_name ~ ' — a ' ~ service_type ~ ' model served by ' ~ provider_display_name, true) %}
{%- set _dual = ' — callable in both OpenAI and Anthropic API styles through the UnitySVC gateway.' %}
{%- set _brief = (_base ~ _dual) if ((_base | length) + (_dual | length) < 195) else _base %}
{%- set _ctx = ' with a ' ~ details.context_length ~ '-token context window' if details.context_length else '' %}
{%- set _detail = display_name ~ ' is served by ' ~ provider_display_name ~ ' over an OpenAI-compatible API' ~ _ctx ~ '. Requests are proxied through the UnitySVC gateway.' %}
{%- set _howto = 'Reach it through the UnitySVC gateway with your own ' ~ provider_display_name ~ ' API key (the byok channel). See the code examples for both API styles.' %}
{#- Dedicated interoperability paragraph: the dual-dialect endpoint is the
    platform differentiator and what makes services interchangeable enough to
    sit behind the gateway's grouping primitives. #}
{%- set _interop = 'One endpoint, either dialect — send an OpenAI Chat Completions or an Anthropic Messages request and the gateway auto-detects the format, translates it for the upstream, and replies in the style you sent. Because every model on UnitySVC speaks both dialects, they are interchangeable behind a single client: swap providers without touching your code, and combine them with the gateway composition primitives — group (/g/), broadcast (/b/), chain (/c/) and failover (/f/).' %}
{#- Closing BYOK pricing paragraph: the price cell just reads "Free (BYOK)"; the provider's reference rates live here where there is room. #}
{%- set _byok = 'Pricing — this is a bring-your-own-key (BYOK) service, so it is free through the UnitySVC gateway; usage is billed by ' ~ provider_display_name ~ ' directly' ~ (' at ' ~ pricing_note if pricing_note else '') ~ '.' %}
{%- set _description = _detail ~ '\n\n' ~ _howto ~ '\n\n' ~ _interop ~ '\n\n' ~ _byok %}
  "summary": {{ (_brief | trim)[:200] | tojson }},
  "description": {{ _description | tojson }},
  "service_type": "{{ service_type }}",
  "capabilities": ["{{ service_type }}"],
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  "tags": ["ai", "gateway", "byok"],
  "details": {{ dict(details or {}, input_formats=["openai", "anthropic"], output_formats=["openai_response", "anthropic_response"]) | tojson }},
{%- if payout_price %}
  "payout_price": {{ payout_price | tojson }},
{%- endif %}
  "upstream_access_config": {
    "byok": {
      "access_method": "http",
{#- applicable_interfaces (unitysvc/unitysvc#1825): instruction-only pairing
    for the how-to-use guide — this service exposes two shared interfaces, and
    without the declaration consumers cannot tell which URL goes with which
    channel. Never consulted by routing: the runtime selects channels by
    request format and does not know which interface a request arrived
    through. #}
      "applicable_interfaces": ["provider_api"],
      "base_url": "{{ api_base_url }}",
      "api_key": "${ customer_secrets.{{ env_api_key_name }} }",
      "rate_limits": [],
      "routing_key": {"model": "{{ offering_name }}"},
      "request_transformer": {
        "llm_translator": "anthropic_to_openai"
      },
      "request_formats": ["openai", "anthropic"],
      "sort_order": 1
    }{% if converse_model_id %},{% endif %}
{#- Native Bedrock runtime channel (unitysvc/unitysvc#1786): Converse and
    InvokeModel via boto3 pointed at the gateway. api_key "__sigv4__": the
    gateway strips the client's credential and re-signs the finalized
    request with AWS SigV4 from the customer's IAM access keys — the client
    authenticates with svcpass as the SigV4 access-key-id and a placeholder
    secret (default-credential boto3 DX, unitysvc#1787).
    base_url carries /model/{{ offering_name }} so the converse_api
    interface's suffix (/converse, /invoke, ...) appends to the correct
    runtime path — and so document rendering can derive the model id from
    the URL in every context. No routing_key: the model is in the URL, and a
    routing_key would make the gateway inject "model" into the Converse JSON
    body, corrupting the schema. No llm_translator: the body passes through
    opaquely. Requests reach this channel by format (request_formats) or an
    explicit @converse pin. #}
{%- if converse_model_id %}
    "converse": {
      "access_method": "http",
      "applicable_interfaces": ["converse_api"],
{#- The NATIVE runtime id, not the mantle id: the two catalogs spell the same
    model differently (qwen.qwen3-32b -> qwen.qwen3-32b-v1:0, moonshotai. ->
    moonshot., ...) and the native runtime rejects mantle spellings with "The
    provided model identifier is invalid". Customers still address the service
    by the mantle id in the converse_api interface URL; the gateway's
    matched-path suffix logic swaps in this native base_url. Models with no
    native id get no converse channel at all (this whole block is gated). #}
      "base_url": "https://bedrock-runtime.us-east-1.amazonaws.com/model/{{ converse_model_id }}",
      "api_key": "__sigv4__",
      "access_key": "${ customer_secrets.AWS_ACCESS_KEY_ID }",
      "secret_key": "${ customer_secrets.AWS_SECRET_ACCESS_KEY }",
      "region": "us-east-1",
      "sigv4_service": "bedrock",
      "description": "Native Bedrock runtime (Converse / InvokeModel, including the streaming variants), signed upstream with your AWS IAM access keys (SigV4). Point boto3 at the gateway: endpoint_url is this service's URL up to (excluding) /model/, and the SDK appends /model/{modelId}/... itself.",
      "rate_limits": [],
      "request_formats": ["bedrock_converse", "bedrock_invoke"],
      "sort_order": 2
    }
{%- endif %}
  }
}

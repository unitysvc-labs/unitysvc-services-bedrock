"""Call this model with the native AWS SDK (boto3) Converse API through the
UnitySVC gateway.

The service URL carries the model id (…/model/<modelId>): everything before
/model/ is the boto3 endpoint_url, and the SDK itself appends
/model/<modelId>/converse to it. boto3 signs the request with SigV4 as
usual — use your UnitySVC API key as the access key id and any placeholder
as the secret. The gateway authenticates the key itself and
re-authenticates upstream with the service's stored credentials, so the
default AWS credential chain, streaming (converse_stream) and InvokeModel
all work unchanged.
"""

import os

import boto3

service_url = "{{ service_base_url }}"
if "/model/" in service_url:
    endpoint_url, model_id = service_url.split("/model/", 1)
else:
    # Shared provider path (no model segment in the URL): the native runtime
    # lives on the provider's dedicated "<provider>-runtime" namespace, where
    # the model id in the URL identifies the service directly.
    endpoint_url = service_url + "-runtime"
    model_id = "{{ routing_key.model if routing_key is defined else '' }}"

{% if local_testing %}
# Local testing: call the Bedrock runtime directly. The test runner
# exports the channel's IAM credentials as AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION — the same variables a
# gateway-routed client fills with svcpass + a placeholder — so boto3's
# default credential chain signs with true values, no explicit wiring.
client = boto3.client(
    "bedrock-runtime",
    endpoint_url=endpoint_url,
    region_name="{{ region | default('us-east-1') }}",
)
{% else %}
client = boto3.client(
    "bedrock-runtime",
    endpoint_url=endpoint_url,
    aws_access_key_id=os.environ["UNITYSVC_API_KEY"],
    aws_secret_access_key="not-used",  # placeholder; the gateway ignores it
    region_name="us-east-1",
)
{% endif %}

response = client.converse(
    modelId=model_id,
    messages=[{"role": "user", "content": [{"text": "Reply with the single word: pong"}]}],
    inferenceConfig={"maxTokens": 64},
)

# Reasoning models emit a reasoningContent block before (or instead of, when
# maxTokens is tight) the text block — print the first text block if there is
# one, else the first block as-is. Never assume content[0] carries "text".
content = response["output"]["message"]["content"]
print(next((block["text"] for block in content if "text" in block), content[0]))
print("connectivity ok")

"""Call this model with boto3 invoke_model() through the UnitySVC gateway.

InvokeModel uses the SAME endpoint and authentication as Converse — only the
request body differs: it is the PROVIDER'S native format, not the unified
Converse schema. The body below is the Anthropic Messages shape used by
anthropic.* model ids; adjust it for your model family (see the provider's
Bedrock documentation for the native request schema of each model).
invoke_model_with_response_stream() works the same way.
"""

import json
import os

import boto3

service_url = "{{ service_base_url }}"
if "/model/" in service_url:
    endpoint_url, model_id = service_url.split("/model/", 1)
else:
    # Shared provider path (no model segment in the URL): the native runtime
    # lives on the provider's dedicated "<provider>-runtime" namespace, where
    # the model id in the URL identifies the service directly.
    endpoint_url = service_url + "-runtime"
    model_id = "{{ routing_key.model if routing_key is defined else '' }}"

{% if local_testing %}
# Local testing: call the Bedrock runtime directly, signing with the real
# AWS IAM access keys resolved from the channel (exported by run-tests as
# the uppercased channel fields).
client = boto3.client(
    "bedrock-runtime",
    endpoint_url=endpoint_url,
    aws_access_key_id=os.environ["ACCESS_KEY"],
    aws_secret_access_key=os.environ["SECRET_KEY"],
    region_name=os.environ.get("REGION", "us-east-1"),
)
{% else %}
client = boto3.client(
    "bedrock-runtime",
    endpoint_url=endpoint_url,
    aws_access_key_id=os.environ["UNITYSVC_API_KEY"],
    aws_secret_access_key="not-used",  # placeholder; the gateway ignores it
    region_name="us-east-1",
)
{% endif %}

body = {
    "anthropic_version": "bedrock-2023-05-31",
    "max_tokens": 16,
    "messages": [{"role": "user", "content": "Reply with the single word: pong"}],
}

response = client.invoke_model(
    modelId=model_id,
    body=json.dumps(body),
    contentType="application/json",
)

print(json.loads(response["body"].read()))
